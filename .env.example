# Configurações do ClimaAlerta
# Copie este arquivo para ".env" e ajuste se necessário.
# Nenhuma chave de API é necessária: Open-Meteo e INMET são fontes públicas.

# --- Banco de dados e logs (caminhos relativos à raiz do projeto)
CLIMAALERTA_DB_PATH=data/climaalerta.db
CLIMAALERTA_LOG_DIR=logs
CLIMAALERTA_LOG_LEVEL=INFO
CLIMAALERTA_TIMEZONE=America/Sao_Paulo

# --- Comportamento HTTP
HTTP_TIMEOUT_SEGUNDOS=15
HTTP_MAX_RETENTATIVAS=3
HTTP_BACKOFF=1.0
HTTP_USER_AGENT=ClimaAlerta/1.0 (projeto educacional; uso local)

# --- Atualização
INTERVALO_ATUALIZACAO_MINUTOS=60
DADOS_DESATUALIZADOS_APOS_MINUTOS=180
DIAS_PREVISAO=7

# --- Endereços das fontes (normalmente não precisam ser alterados)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
INMET_AVISOS_URL=https://apiprevmet3.inmet.gov.br/avisos/ativos
INMET_AVISO_PAGINA_URL=https://avisos.inmet.gov.br/{id}
IBGE_MUNICIPIOS_URL=https://servicodados.ibge.gov.br/api/v1/localidades/estados/{uf}/municipios

# --- Selenium
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT_SEGUNDOS=10

# --- Limites dos indicadores locais
# ATENÇÃO: valores DEMONSTRATIVOS para fins didáticos, NÃO são recomendações oficiais.
LIMITE_PROBABILIDADE_CHUVA=70
LIMITE_PRECIPITACAO_HORARIA_MM=10
LIMITE_PRECIPITACAO_DIARIA_MM=30
LIMITE_RAJADA_KMH=60
LIMITE_TEMPERATURA_MAXIMA_C=35
LIMITE_TEMPERATURA_MINIMA_C=3
LIMITE_UMIDADE_MINIMA=30
